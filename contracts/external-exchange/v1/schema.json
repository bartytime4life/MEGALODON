{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megalodon.local/contracts/external-exchange/v1/schema.json",
  "title": "MEGALODON external exchange contract v1",
  "description": "Static contract for offline threat context, local file-only SIEM projections, and an inert SOAR handoff. Validation performs no I/O or action.",
  "$ref": "#/$defs/plan",
  "$defs": {
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "status", "network_access_performed", "host_change_performed", "lanes"],
      "properties": {
        "schema_version": {"const": "megalodon-external-exchange-v1"},
        "status": {"const": "contract_only"},
        "network_access_performed": {"const": false},
        "host_change_performed": {"const": false},
        "lanes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "allOf": [
            {
              "contains": {"$ref": "#/$defs/threatContext"},
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {"$ref": "#/$defs/siemExport"},
              "minContains": 1,
              "maxContains": 1
            },
            {
              "contains": {"$ref": "#/$defs/soarHandoff"},
              "minContains": 1,
              "maxContains": 1
            }
          ],
          "items": {
            "oneOf": [
              {"$ref": "#/$defs/threatContext"},
              {"$ref": "#/$defs/siemExport"},
              {"$ref": "#/$defs/soarHandoff"}
            ]
          }
        }
      }
    },
    "threatContext": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "input_mode", "format", "max_bundle_bytes", "max_objects", "max_nesting_depth", "artifact_digest", "markings", "pattern_handling", "runtime_fetch", "taxii", "attribution_authority", "action_authority"],
      "properties": {
        "lane": {"const": "threat-context-import"},
        "input_mode": {"const": "operator_supplied_completed_file"},
        "format": {"const": "stix-2.1-json"},
        "max_bundle_bytes": {"const": 16777216},
        "max_objects": {"const": 4096},
        "max_nesting_depth": {"const": 32},
        "artifact_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "markings": {"const": "preserve"},
        "pattern_handling": {"const": "store_as_untrusted_text_never_execute"},
        "runtime_fetch": {"const": false},
        "taxii": {"const": false},
        "attribution_authority": {"const": false},
        "action_authority": {"const": "none"}
      }
    },
    "siemExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "output_mode", "profiles", "max_records", "max_output_bytes", "include_event_original", "include_payload", "network_delivery", "credentials", "action_authority"],
      "properties": {
        "lane": {"const": "siem-export"},
        "output_mode": {"const": "new_local_file_only"},
        "profiles": {
          "type": "array",
          "prefixItems": [{"const": "ecs-9.5.0"}, {"const": "ocsf-1.9.0"}],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "max_records": {"const": 10000},
        "max_output_bytes": {"const": 16777216},
        "include_event_original": {"const": false},
        "include_payload": {"const": false},
        "network_delivery": {"const": false},
        "credentials": {"const": false},
        "action_authority": {"const": "none"}
      }
    },
    "soarHandoff": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane", "output_mode", "destination_class", "max_attempts", "status", "endpoint", "credentials", "network_delivery", "host_action", "automation"],
      "properties": {
        "lane": {"const": "soar-handoff"},
        "output_mode": {"const": "inert_local_handoff_only"},
        "destination_class": {"const": "not_configured"},
        "max_attempts": {"const": 0},
        "status": {"const": "not_attempted"},
        "endpoint": {"const": false},
        "credentials": {"const": false},
        "network_delivery": {"const": false},
        "host_action": {"const": false},
        "automation": {"const": false}
      }
    },
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ip"],
      "properties": {
        "ip": {"type": "string", "minLength": 2, "maxLength": 45},
        "port": {"type": "integer", "minimum": 0, "maximum": 65535}
      }
    },
    "ecsRecord": {
      "description": "MEGALODON's own bounded ECS 9.5.0 profile: a minimal, verifiable field subset. Every non-standard value lives under the free-form `megalodon` namespace, ECS's own sanctioned custom-fields mechanism. This is not a claim of full ECS compliance, and `event.original` is never present.",
      "type": "object",
      "additionalProperties": false,
      "required": ["@timestamp", "event", "source", "destination", "network", "message", "rule", "megalodon"],
      "properties": {
        "@timestamp": {"$ref": "#/$defs/utcTimestamp"},
        "event": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "category", "type", "severity", "id", "dataset", "ingested"],
          "properties": {
            "kind": {"const": "alert"},
            "category": {
              "type": "array",
              "prefixItems": [{"const": "network"}, {"const": "intrusion_detection"}],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "type": {
              "type": "array",
              "prefixItems": [{"const": "info"}],
              "items": false,
              "minItems": 1,
              "maxItems": 1
            },
            "severity": {"enum": [25, 50, 75, 99]},
            "id": {"$ref": "#/$defs/logicalId"},
            "dataset": {"const": "megalodon.detection"},
            "ingested": {"$ref": "#/$defs/utcTimestamp"}
          }
        },
        "source": {"$ref": "#/$defs/endpoint"},
        "destination": {"$ref": "#/$defs/endpoint"},
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": ["transport", "bytes"],
          "properties": {
            "transport": {"type": "string", "minLength": 1, "maxLength": 32},
            "bytes": {"type": "integer", "minimum": 0}
          }
        },
        "message": {"$ref": "#/$defs/boundedText"},
        "rule": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {"id": {"$ref": "#/$defs/logicalId"}}
        },
        "megalodon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "run_id", "event_id", "detection_id", "source_kind", "recommendation", "completeness", "projection_version"],
          "properties": {
            "schema_version": {"const": "megalodon-ecs-profile-v1"},
            "run_id": {"$ref": "#/$defs/logicalId"},
            "event_id": {"$ref": "#/$defs/logicalId"},
            "detection_id": {"$ref": "#/$defs/logicalId"},
            "source_kind": {"enum": ["sample", "jsonl", "scapy"]},
            "recommendation": {"$ref": "#/$defs/boundedText"},
            "suppressed_reason": {"$ref": "#/$defs/boundedText"},
            "completeness": {"enum": ["complete", "partial"]},
            "projection_version": {"const": "1"}
          }
        }
      }
    },
    "ocsfRecord": {
      "description": "MEGALODON's own bounded OCSF 1.9.0 profile: Network Activity class (4001) with a minimal, verifiable field subset. Every value this repository is not confident maps to a specific upstream enum uses OCSF's own generic `99`/\"Other\" sentinel, and every non-standard value lives under `unmapped`, OCSF's own sanctioned vendor-extension mechanism. This is not a claim of full OCSF compliance.",
      "type": "object",
      "additionalProperties": false,
      "required": ["class_uid", "class_name", "category_uid", "category_name", "activity_id", "activity_name", "severity_id", "severity", "time", "metadata", "src_endpoint", "dst_endpoint", "connection_info", "message", "unmapped"],
      "properties": {
        "class_uid": {"const": 4001},
        "class_name": {"const": "Network Activity"},
        "category_uid": {"const": 4},
        "category_name": {"const": "Network Activity"},
        "activity_id": {"const": 99},
        "activity_name": {"const": "Other"},
        "severity_id": {"enum": [2, 3, 4, 5]},
        "severity": {"enum": ["Low", "Medium", "High", "Critical"]},
        "time": {"type": "integer", "minimum": 0},
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "product", "uid"],
          "properties": {
            "version": {"const": "1.9.0"},
            "product": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "vendor_name"],
              "properties": {
                "name": {"const": "MEGALODON"},
                "vendor_name": {"const": "MEGALODON"}
              }
            },
            "uid": {"$ref": "#/$defs/logicalId"}
          }
        },
        "src_endpoint": {"$ref": "#/$defs/endpoint"},
        "dst_endpoint": {"$ref": "#/$defs/endpoint"},
        "connection_info": {
          "type": "object",
          "additionalProperties": false,
          "required": ["protocol_name"],
          "properties": {"protocol_name": {"type": "string", "minLength": 1, "maxLength": 32}}
        },
        "message": {"$ref": "#/$defs/boundedText"},
        "unmapped": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "run_id", "event_id", "detection_id", "rule_id", "source_kind", "recommendation", "byte_count", "completeness", "projection_version", "megalodon_activity"],
          "properties": {
            "schema_version": {"const": "megalodon-ocsf-profile-v1"},
            "run_id": {"$ref": "#/$defs/logicalId"},
            "event_id": {"$ref": "#/$defs/logicalId"},
            "detection_id": {"$ref": "#/$defs/logicalId"},
            "rule_id": {"$ref": "#/$defs/logicalId"},
            "source_kind": {"enum": ["sample", "jsonl", "scapy"]},
            "recommendation": {"$ref": "#/$defs/boundedText"},
            "suppressed_reason": {"$ref": "#/$defs/boundedText"},
            "byte_count": {"type": "integer", "minimum": 0},
            "completeness": {"enum": ["complete", "partial"]},
            "projection_version": {"const": "1"},
            "megalodon_activity": {"const": "detection"}
          }
        }
      }
    }
  }
}
