{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megalodon.local/contracts/local-model-advisory/v1/schema.json",
  "title": "MEGALODON local model advisory contract v1 (draft)",
  "description": "Data-only contract. Validation never contacts a provider, reads evidence, starts a model, executes a tool, or changes the host.",
  "$defs": {
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1200,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "boundedCode": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "modelReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_class", "model_id", "model_artifact_sha256", "policy_version"],
      "properties": {
        "provider_class": {"const": "local_loopback"},
        "model_id": {"type": "string", "pattern": "^local:qwen-[A-Za-z0-9._-]{1,96}$"},
        "model_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "policy_version": {"const": "local-model-advisory-v1"}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_input_bytes", "max_output_bytes", "timeout_seconds", "max_concurrency"],
      "properties": {
        "max_input_bytes": {"const": 4096},
        "max_output_bytes": {"const": 4096},
        "timeout_seconds": {"const": 15},
        "max_concurrency": {"const": 1}
      }
    },
    "localModelRegistry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "models", "tools"],
      "properties": {
        "schema": {"const": "local-model-registry-v1"},
        "models": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["model_receipt", "limits"],
            "properties": {
              "model_receipt": {"$ref": "#/$defs/modelReceipt"},
              "limits": {"$ref": "#/$defs/limits"}
            }
          }
        },
        "tools": {"type": "array", "maxItems": 0}
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_kind", "adapter_id", "terminal_status", "accepted_records", "rejected_records", "candidate_count", "question_type"],
      "properties": {
        "source_kind": {"enum": ["sample", "jsonl", "scapy", "tshark", "zeek-json", "zeek-tsv"]},
        "adapter_id": {"$ref": "#/$defs/logicalId"},
        "terminal_status": {"enum": ["complete", "failed"]},
        "accepted_records": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "rejected_records": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 1000000},
            {"type": "null"}
          ]
        },
        "candidate_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "question_type": {"enum": ["explain_run", "explain_rule_limitations"]}
      },
      "allOf": [
        {
          "if": {"properties": {"terminal_status": {"const": "complete"}}},
          "then": {
            "properties": {
              "rejected_records": {"type": "integer", "minimum": 0, "maximum": 1000000}
            }
          }
        }
      ]
    },
    "advisoryRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "model_receipt", "limits"],
      "properties": {
        "projection": {"$ref": "#/$defs/projection"},
        "model_receipt": {"$ref": "#/$defs/modelReceipt"},
        "limits": {"$ref": "#/$defs/limits"}
      }
    },
    "advisoryResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "code", "summary", "limitations", "model_receipt"],
      "properties": {
        "outcome": {"enum": ["ANSWER", "ABSTAIN", "DENY", "ERROR"]},
        "code": {"$ref": "#/$defs/boundedCode"},
        "summary": {"$ref": "#/$defs/boundedText"},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/boundedText"}
        },
        "model_receipt": {"$ref": "#/$defs/modelReceipt"}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "ANSWER"}}},
          "then": {"properties": {"code": {"const": "ADVISORY_ANSWER"}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "ABSTAIN"}}},
          "then": {"properties": {"code": {"const": "INSUFFICIENT_ALLOWED_CONTEXT"}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "DENY"}}},
          "then": {"properties": {"code": {"const": "POLICY_DENIED"}}}
        },
        {
          "if": {"properties": {"outcome": {"const": "ERROR"}}},
          "then": {"properties": {"code": {"const": "LOCAL_PROVIDER_ERROR"}}}
        }
      ]
    },
    "advisoryInvocationReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "code",
        "reason_code",
        "summary",
        "limitations",
        "model_receipt",
        "registry_sha256",
        "provider_request_performed"
      ],
      "properties": {
        "outcome": {"enum": ["ANSWER", "DENY", "ERROR"]},
        "code": {"enum": ["ADVISORY_ANSWER", "POLICY_DENIED", "LOCAL_PROVIDER_ERROR"]},
        "reason_code": {
          "enum": [
            "REQUEST_COMPLETED",
            "PROVIDER_DISABLED",
            "INVOCATION_CONTROL_INVALID",
            "REGISTRY_PIN_INVALID",
            "REGISTRY_INVALID",
            "REGISTRY_FINGERPRINT_MISMATCH",
            "REQUEST_SHAPE_INVALID",
            "MODEL_NOT_APPROVED",
            "INPUT_LIMIT_EXCEEDED",
            "CANCELLED_BEFORE_REQUEST",
            "CANCELLED_DURING_RESPONSE",
            "PROVIDER_BUSY",
            "PROVIDER_TIMEOUT",
            "PROVIDER_UNAVAILABLE",
            "PROVIDER_REDIRECT_DENIED",
            "PROVIDER_HTTP_ERROR",
            "PROVIDER_PROTOCOL_ERROR",
            "PROVIDER_RESPONSE_TOO_LARGE",
            "PROVIDER_RESPONSE_INVALID",
            "PROVIDER_MODEL_MISMATCH",
            "PROVIDER_CLOSE_FAILED"
          ]
        },
        "summary": {"$ref": "#/$defs/boundedText"},
        "limitations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/boundedText"}
        },
        "model_receipt": {
          "oneOf": [
            {"$ref": "#/$defs/modelReceipt"},
            {"type": "null"}
          ]
        },
        "registry_sha256": {
          "oneOf": [
            {"type": "string", "pattern": "^[a-f0-9]{64}$"},
            {"type": "null"}
          ]
        },
        "provider_request_performed": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"outcome": {"const": "ANSWER"}}},
          "then": {
            "properties": {
              "code": {"const": "ADVISORY_ANSWER"},
              "reason_code": {"const": "REQUEST_COMPLETED"},
              "model_receipt": {"$ref": "#/$defs/modelReceipt"},
              "registry_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
              "provider_request_performed": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "DENY"}}},
          "then": {
            "properties": {
              "code": {"const": "POLICY_DENIED"},
              "provider_request_performed": {"const": false}
            }
          }
        },
        {
          "if": {"properties": {"outcome": {"const": "ERROR"}}},
          "then": {"properties": {"code": {"const": "LOCAL_PROVIDER_ERROR"}}}
        }
      ]
    }
  }
}
