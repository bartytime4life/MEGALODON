{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megalodon.local/contracts/alert-lifecycle/v1/schema.json",
  "title": "MEGALODON alert lifecycle contract v1 (draft)",
  "description": "Data-only contract. Validation does not create alerts, persist a ledger, identify an operator, send a notification, contact an endpoint, or authorize a host action.",
  "$defs": {
    "logicalId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "boundedText": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[^\\u0000-\\u001F\\u007F]+$"
    },
    "alertState": {
      "enum": ["open", "acknowledged", "resolved", "suppressed", "expired"]
    },
    "alertProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "detection_id", "policy_version", "state", "revision", "created_at", "updated_at"],
      "properties": {
        "id": {"$ref": "#/$defs/logicalId"},
        "detection_id": {"$ref": "#/$defs/logicalId"},
        "policy_version": {"$ref": "#/$defs/logicalId"},
        "state": {"$ref": "#/$defs/alertState"},
        "revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "created_at": {"$ref": "#/$defs/utcTimestamp"},
        "updated_at": {"$ref": "#/$defs/utcTimestamp"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alert_id", "policy_version", "sequence", "expected_revision", "from_state", "to_state", "actor_id", "reason_code", "idempotency_key", "occurred_at"],
      "properties": {
        "id": {"$ref": "#/$defs/logicalId"},
        "alert_id": {"$ref": "#/$defs/logicalId"},
        "policy_version": {"$ref": "#/$defs/logicalId"},
        "sequence": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "expected_revision": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "from_state": {"$ref": "#/$defs/alertState"},
        "to_state": {"$ref": "#/$defs/alertState"},
        "actor_id": {"$ref": "#/$defs/logicalId"},
        "reason_code": {"$ref": "#/$defs/boundedText"},
        "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 384, "pattern": "^[A-Za-z0-9._:-]+$"},
        "occurred_at": {"$ref": "#/$defs/utcTimestamp"}
      }
    },
    "outboxIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "alert_id", "transition_id", "policy_version", "destination_class", "max_attempts", "status", "created_at"],
      "properties": {
        "id": {"$ref": "#/$defs/logicalId"},
        "alert_id": {"$ref": "#/$defs/logicalId"},
        "transition_id": {"$ref": "#/$defs/logicalId"},
        "policy_version": {"$ref": "#/$defs/logicalId"},
        "destination_class": {"enum": ["not_configured"]},
        "max_attempts": {"const": 0},
        "status": {"const": "pending"},
        "created_at": {"$ref": "#/$defs/utcTimestamp"}
      }
    },
    "receiptCode": {
      "enum": [
        "DELIVERY_NOT_CONFIGURED",
        "DELIVERY_ATTEMPTED",
        "DELIVERY_DELIVERED",
        "DELIVERY_FAILED",
        "DELIVERY_TIMEOUT_AMBIGUOUS",
        "DELIVERY_EXPIRED",
        "DELIVERY_SUPPRESSED",
        "DELIVERY_DEAD_LETTERED"
      ]
    },
    "deliveryReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "outbox_id", "attempt", "status", "code", "occurred_at"],
      "properties": {
        "id": {"$ref": "#/$defs/logicalId"},
        "outbox_id": {"$ref": "#/$defs/logicalId"},
        "attempt": {"type": "integer", "minimum": 0, "maximum": 3},
        "status": {"enum": ["not_attempted", "attempted", "delivered", "failed", "expired", "suppressed", "dead_lettered"]},
        "code": {"$ref": "#/$defs/receiptCode"},
        "occurred_at": {"$ref": "#/$defs/utcTimestamp"}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "not_attempted"}}},
          "then": {"properties": {"attempt": {"const": 0}, "code": {"const": "DELIVERY_NOT_CONFIGURED"}}}
        },
        {
          "if": {"properties": {"status": {"const": "attempted"}}},
          "then": {"properties": {"attempt": {"minimum": 1}, "code": {"const": "DELIVERY_ATTEMPTED"}}}
        },
        {
          "if": {"properties": {"status": {"const": "delivered"}}},
          "then": {"properties": {"attempt": {"minimum": 1}, "code": {"const": "DELIVERY_DELIVERED"}}}
        },
        {
          "if": {"properties": {"status": {"const": "failed"}}},
          "then": {"properties": {"attempt": {"minimum": 1}, "code": {"enum": ["DELIVERY_FAILED", "DELIVERY_TIMEOUT_AMBIGUOUS"]}}}
        },
        {
          "if": {"properties": {"status": {"const": "expired"}}},
          "then": {"properties": {"code": {"const": "DELIVERY_EXPIRED"}}}
        },
        {
          "if": {"properties": {"status": {"const": "suppressed"}}},
          "then": {"properties": {"code": {"const": "DELIVERY_SUPPRESSED"}}}
        },
        {
          "if": {"properties": {"status": {"const": "dead_lettered"}}},
          "then": {"properties": {"attempt": {"minimum": 1}, "code": {"const": "DELIVERY_DEAD_LETTERED"}}}
        }
      ]
    }
  }
}
