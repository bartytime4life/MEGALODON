          "ruleset_id": "TTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTTT",
          "ruleset_basis": "operator_declared"
        },
        "record_count": 10000,
