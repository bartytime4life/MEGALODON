{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megalodon.local/contracts/suricata-eve/v1/qualification/experiment/receipt.schema.json",
  "title": "MEGALODON bounded Suricata native experiment receipt",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "pcre_ratio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from_segments", "to_segments", "numerator_ns", "denominator_ns"],
      "properties": {
        "from_segments": {"enum": [32, 64]},
        "to_segments": {"enum": [64, 128]},
        "numerator_ns": {"type": "integer", "minimum": 1},
        "denominator_ns": {"type": "integer", "minimum": 1}
      }
    },
    "pcre_run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stream_segments",
        "repetition",
        "signature_id",
        "alert_count",
        "exit_code",
        "timed_out",
        "output_truncated",
        "output_bytes",
        "wall_ns",
        "process_cpu_ns",
        "max_address_space_bytes"
      ],
      "properties": {
        "stream_segments": {"enum": [32, 64, 128]},
        "repetition": {"type": "integer", "minimum": 1, "maximum": 3},
        "signature_id": {"const": 9900002},
        "alert_count": {"type": "integer", "minimum": 1},
        "exit_code": {"const": 0},
        "timed_out": {"const": false},
        "output_truncated": {"const": false},
        "output_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "wall_ns": {"type": "integer", "minimum": 1, "maximum": 10000000000},
        "process_cpu_ns": {"type": "integer", "minimum": 1},
        "max_address_space_bytes": {"type": "integer", "minimum": 1, "maximum": 536870912}
      }
    }
  },
  "required": [
    "schema_version",
    "packet_sha256",
    "status",
    "canonicalization",
    "receipt_id",
    "producer",
    "artifact_verification",
    "execution",
    "oracle",
    "effects",
    "acceptance_authority",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "suricata-engine-native-receipt-v1"},
    "packet_sha256": {"const": "54954ad77372b9b4b3a65f8082db2d611d725937775e7fe4ee8210cde4b4814d"},
    "status": {
      "enum": [
        "not_run",
        "unavailable_prerequisite",
        "identity_mismatch",
        "timeout",
        "output_limit",
        "nonzero_exit",
        "oracle_failed",
        "pass"
      ]
    },
    "canonicalization": {"const": "utf8-json-sort-keys-compact-v1"},
    "receipt_id": {
      "anyOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "version", "sha256", "verified_ancestry", "exact_identity_verified"],
      "properties": {
        "role": {"enum": ["none", "baseline", "candidate"]},
        "version": {"type": ["string", "null"], "maxLength": 128},
        "sha256": {
          "anyOf": [
            {"type": "null"},
            {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          ]
        },
        "verified_ancestry": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "uniqueItems": true,
          "maxItems": 2
        },
        "exact_identity_verified": {"type": "boolean"}
      }
    },
    "artifact_verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256_verified", "all_artifact_sha256_verified"],
      "properties": {
        "manifest_sha256_verified": {"type": "boolean"},
        "all_artifact_sha256_verified": {"type": "boolean"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "native",
        "exit_code",
        "timed_out",
        "output_truncated",
        "output_bytes",
        "wall_ns",
        "process_cpu_ns",
        "max_address_space_bytes"
      ],
      "properties": {
        "native": {"type": "boolean"},
        "exit_code": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
        "timed_out": {"type": "boolean"},
        "output_truncated": {"type": "boolean"},
        "output_bytes": {"type": "integer", "minimum": 0, "maximum": 1048576},
        "wall_ns": {"type": ["integer", "null"], "minimum": 0, "maximum": 10000000000},
        "process_cpu_ns": {"type": ["integer", "null"], "minimum": 0},
        "max_address_space_bytes": {"type": ["integer", "null"], "minimum": 0, "maximum": 536870912}
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "tls_alert", "pcre_runs", "pcre_ratios"],
      "properties": {
        "state": {"enum": ["not_evaluated", "passed", "failed"]},
        "tls_alert": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["signature_id", "app_proto", "alert_count"],
              "properties": {
                "signature_id": {"const": 9900001},
                "app_proto": {"const": "tls"},
                "alert_count": {"const": 1}
              }
            }
          ]
        },
        "pcre_runs": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 9,
              "maxItems": 9,
              "items": false,
              "prefixItems": [
                {"allOf": [{"$ref": "#/$defs/pcre_run"}, {"properties": {"stream_segments": {"const": 32}, "repetition": {"const": 1}}}]},
                {"allOf": [{"$ref": "#/$defs/pcre_run"}, {"properties": {"stream_segments": {"const": 32}, "repetition": {"const": 2}}}]},
                {"allOf": [{"$ref": "#/$defs/pcre_run"}, {"properties": {"stream_segments": {"const": 32}, "repetition": {"const": 3}}}]},
                {"allOf": [{"$ref": "#/$defs/pcre_run"}, {"properties": {"stream_segments": {"const": 64}, "repetition": {"const": 1}}}]},
                {"allOf": [{"$ref": "#/$defs/pcre_run"}, {"properties": {"stream_segments": {"const": 64}, "repetition": {"const": 2}}}]},
                {"allOf": [{"$ref": "#/$defs/pcre_run"}, {"properties": {"stream_segments": {"const": 64}, "repetition": {"const": 3}}}]},
                {"allOf": [{"$ref": "#/$defs/pcre_run"}, {"properties": {"stream_segments": {"const": 128}, "repetition": {"const": 1}}}]},
                {"allOf": [{"$ref": "#/$defs/pcre_run"}, {"properties": {"stream_segments": {"const": 128}, "repetition": {"const": 2}}}]},
                {"allOf": [{"$ref": "#/$defs/pcre_run"}, {"properties": {"stream_segments": {"const": 128}, "repetition": {"const": 3}}}]}
              ]
            }
          ]
        },
        "pcre_ratios": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": false,
              "prefixItems": [
                {"allOf": [{"$ref": "#/$defs/pcre_ratio"}, {"properties": {"from_segments": {"const": 32}, "to_segments": {"const": 64}}}]},
                {"allOf": [{"$ref": "#/$defs/pcre_ratio"}, {"properties": {"from_segments": {"const": 64}, "to_segments": {"const": 128}}}]}
              ]
            }
          ]
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suricata_executed",
        "network_used",
        "live_capture_used",
        "rules_updated",
        "service_changed",
        "host_changed",
        "firewall_changed",
        "shell_action_used",
        "model_invoked"
      ],
      "properties": {
        "suricata_executed": {"type": "boolean"},
        "network_used": {"const": false},
        "live_capture_used": {"const": false},
        "rules_updated": {"const": false},
        "service_changed": {"const": false},
        "host_changed": {"const": false},
        "firewall_changed": {"const": false},
        "shell_action_used": {"const": false},
        "model_invoked": {"const": false}
      }
    },
    "acceptance_authority": {"const": false},
    "error": {
      "enum": [
        null,
        "UNAVAILABLE_PREREQUISITE",
        "IDENTITY_MISMATCH",
        "TIMEOUT",
        "OUTPUT_LIMIT",
        "NONZERO_EXIT",
        "ORACLE_FAILED"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "not_run"}}, "required": ["status"]},
      "then": {
        "properties": {
          "receipt_id": {"const": null},
          "producer": {
            "properties": {
              "role": {"const": "none"},
              "version": {"const": null},
              "sha256": {"const": null},
              "verified_ancestry": {"maxItems": 0},
              "exact_identity_verified": {"const": false}
            }
          },
          "artifact_verification": {
            "properties": {
              "manifest_sha256_verified": {"const": false},
              "all_artifact_sha256_verified": {"const": false}
            }
          },
          "execution": {
            "properties": {
              "native": {"const": false},
              "exit_code": {"const": null},
              "timed_out": {"const": false},
              "output_truncated": {"const": false},
              "output_bytes": {"const": 0},
              "wall_ns": {"const": null},
              "process_cpu_ns": {"const": null},
              "max_address_space_bytes": {"const": null}
            }
          },
          "oracle": {
            "properties": {
              "state": {"const": "not_evaluated"},
              "tls_alert": {"const": null},
              "pcre_runs": {"const": null},
              "pcre_ratios": {"const": null}
            }
          },
          "effects": {"properties": {"suricata_executed": {"const": false}}},
          "error": {"const": null}
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "pass"}}, "required": ["status"]},
      "then": {
        "properties": {
          "receipt_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "producer": {
            "properties": {
              "role": {"enum": ["baseline", "candidate"]},
              "version": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "exact_identity_verified": {"const": true}
            }
          },
          "artifact_verification": {
            "properties": {
              "manifest_sha256_verified": {"const": true},
              "all_artifact_sha256_verified": {"const": true}
            }
          },
          "execution": {
            "properties": {
              "native": {"const": true},
              "exit_code": {"const": 0},
              "timed_out": {"const": false},
              "output_truncated": {"const": false},
              "output_bytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
              "wall_ns": {"type": "integer", "minimum": 1},
              "process_cpu_ns": {"type": "integer", "minimum": 1},
              "max_address_space_bytes": {"type": "integer", "minimum": 1}
            }
          },
          "oracle": {
            "properties": {
              "state": {"const": "passed"},
              "tls_alert": {"type": "object"},
              "pcre_runs": {"type": "array", "minItems": 9, "maxItems": 9},
              "pcre_ratios": {"type": "array", "minItems": 2, "maxItems": 2}
            }
          },
          "effects": {"properties": {"suricata_executed": {"const": true}}},
          "error": {"const": null}
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "pass"},
          "producer": {"properties": {"role": {"const": "baseline"}}, "required": ["role"]}
        },
        "required": ["status", "producer"]
      },
      "then": {
        "properties": {
          "producer": {
            "properties": {
              "version": {"const": "8.0.7"},
              "verified_ancestry": {"maxItems": 0}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {"const": "pass"},
          "producer": {"properties": {"role": {"const": "candidate"}}, "required": ["role"]}
        },
        "required": ["status", "producer"]
      },
      "then": {
        "properties": {
          "producer": {
            "properties": {
              "verified_ancestry": {
                "minItems": 2,
                "maxItems": 2,
                "items": false,
                "prefixItems": [
                  {"const": "bea218e7b1dd8ffb09f250e62c096c6b3da749b4"},
                  {"const": "f87b8e64a5fb80788897f7a9073c5407a2f5bc96"}
                ]
              }
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"status": {"const": "unavailable_prerequisite"}}, "required": ["status"]},
      "then": {"properties": {"error": {"const": "UNAVAILABLE_PREREQUISITE"}}}
    },
    {
      "if": {"properties": {"status": {"const": "identity_mismatch"}}, "required": ["status"]},
      "then": {"properties": {"error": {"const": "IDENTITY_MISMATCH"}, "producer": {"properties": {"exact_identity_verified": {"const": false}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "timeout"}}, "required": ["status"]},
      "then": {"properties": {"error": {"const": "TIMEOUT"}, "execution": {"properties": {"timed_out": {"const": true}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "output_limit"}}, "required": ["status"]},
      "then": {"properties": {"error": {"const": "OUTPUT_LIMIT"}, "execution": {"properties": {"output_truncated": {"const": true}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "nonzero_exit"}}, "required": ["status"]},
      "then": {"properties": {"error": {"const": "NONZERO_EXIT"}, "execution": {"properties": {"exit_code": {"type": "integer", "minimum": 1}}}}}
    },
    {
      "if": {"properties": {"status": {"const": "oracle_failed"}}, "required": ["status"]},
      "then": {"properties": {"error": {"const": "ORACLE_FAILED"}, "oracle": {"properties": {"state": {"const": "failed"}}}}}
    }
  ]
}
