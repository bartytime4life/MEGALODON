{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megalodon.local/contracts/suricata-eve/v1/qualification/schema.json",
  "title": "MEGALODON Suricata engine regression research packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer",
    "cases",
    "proposed_limits",
    "effects",
    "disposition",
    "remaining_holds"
  ],
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "upstream_commit",
        "upstream_url",
        "upstream_date",
        "ticket",
        "verified_observation",
        "fixture_status",
        "execution_status",
        "evidence_status"
      ],
      "properties": {
        "id": {
          "enum": [
            "fragmented_tls_handshake_header",
            "pcre_only_stream_progress"
          ]
        },
        "upstream_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "upstream_url": {
          "type": "string",
          "pattern": "^https://github\\.com/OISF/suricata/commit/[0-9a-f]{40}$"
        },
        "upstream_date": {"const": "2026-10-22"},
        "ticket": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99999
        },
        "verified_observation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "fixture_status": {"const": "not_supplied"},
        "execution_status": {"const": "not_run"},
        "evidence_status": {"const": "research_only"}
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "suricata-engine-regression-research-v1"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "version", "acceptance"],
      "properties": {
        "profile": {"const": "suricata-8.0.7-alert-json-v1"},
        "version": {"const": "8.0.7"},
        "acceptance": {"const": "not_established"}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {
          "allOf": [
            {"$ref": "#/$defs/case"},
            {
              "properties": {
                "id": {"const": "fragmented_tls_handshake_header"},
                "upstream_commit": {"const": "bea218e7b1dd8ffb09f250e62c096c6b3da749b4"},
                "upstream_url": {"const": "https://github.com/OISF/suricata/commit/bea218e7b1dd8ffb09f250e62c096c6b3da749b4"},
                "upstream_date": {"const": "2026-10-22"},
                "ticket": {"const": 9167},
                "verified_observation": {"const": "Upstream reports that a TLS handshake header shorter than four bytes could make the parser error and disable further protocol inspection; the candidate commit buffers the header across records."}
              }
            }
          ]
        },
        {
          "allOf": [
            {"$ref": "#/$defs/case"},
            {
              "properties": {
                "id": {"const": "pcre_only_stream_progress"},
                "upstream_commit": {"const": "f87b8e64a5fb80788897f7a9073c5407a2f5bc96"},
                "upstream_url": {"const": "https://github.com/OISF/suricata/commit/f87b8e64a5fb80788897f7a9073c5407a2f5bc96"},
                "upstream_date": {"const": "2026-10-22"},
                "ticket": {"const": 8684},
                "verified_observation": {"const": "Upstream reports that a PCRE-only TCP stream rule group could re-evaluate the whole growing stream for each packet, producing quadratic work when no multipattern prefilter advanced raw-stream progress."}
              }
            }
          ]
        }
      ],
      "items": false
    },
    "proposed_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_fixture_bytes",
        "max_packets",
        "max_output_bytes",
        "max_wall_seconds_per_case",
        "max_address_space_bytes",
        "threads"
      ],
      "properties": {
        "max_fixture_bytes": {"const": 262144},
        "max_packets": {"const": 512},
        "max_output_bytes": {"const": 1048576},
        "max_wall_seconds_per_case": {"const": 10},
        "max_address_space_bytes": {"const": 536870912},
        "threads": {"const": 1}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_downloaded",
        "suricata_executed",
        "network_used",
        "live_capture_used",
        "rules_updated",
        "service_changed",
        "host_changed",
        "firewall_changed",
        "shell_action_used",
        "model_invoked"
      ],
      "properties": {
        "fixture_downloaded": {"const": false},
        "suricata_executed": {"const": false},
        "network_used": {"const": false},
        "live_capture_used": {"const": false},
        "rules_updated": {"const": false},
        "service_changed": {"const": false},
        "host_changed": {"const": false},
        "firewall_changed": {"const": false},
        "shell_action_used": {"const": false},
        "model_invoked": {"const": false}
      }
    },
    "disposition": {"const": "not_run_research_candidate"},
    "remaining_holds": {
      "const": [
        "OWNER_AUTHORIZATION",
        "SYNTHETIC_FIXTURE_PROVENANCE",
        "EXACT_BINARY_IDENTITY",
        "NATIVE_RESOURCE_CONTAINMENT",
        "EXPECTED_OUTPUT_ORACLE",
        "INDEPENDENT_REVIEW",
        "INSTALLED_PRODUCER_ACCEPTANCE",
        "OPERATIONAL_PRIVACY"
      ]
    }
  }
}
