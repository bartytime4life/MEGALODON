{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megalodon.local/contracts/suricata-eve/v1/producer/schema.json",
  "title": "MEGALODON Suricata 8.0.7 raw-EVE producer profile",
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "eveTime": {
      "type": "string",
      "minLength": 20,
      "maxLength": 32,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:?[0-9]{2})$"
    },
    "ip": {
      "type": "string",
      "minLength": 2,
      "maxLength": 45,
      "pattern": "^[0-9A-Fa-f:.]+$"
    },
    "port": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "printable64": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[ -~]+$"
    },
    "printable128": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[ -~]+$"
    },
    "printable160": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[ -~]+$"
    },
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "gid", "signature_id", "rev", "severity"],
      "properties": {
        "action": {"enum": ["allowed", "blocked"]},
        "gid": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "signature_id": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "rev": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "severity": {"type": "integer", "minimum": 1, "maximum": 255},
        "signature": {"$ref": "#/$defs/printable160"},
        "category": {"$ref": "#/$defs/printable160"}
      }
    },
    "rawAlert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "timestamp", "event_type", "src_ip", "src_port", "dest_ip",
        "dest_port", "proto", "alert"
      ],
      "properties": {
        "timestamp": {"$ref": "#/$defs/eveTime"},
        "event_type": {"const": "alert"},
        "src_ip": {"$ref": "#/$defs/ip"},
        "src_port": {"$ref": "#/$defs/port"},
        "dest_ip": {"$ref": "#/$defs/ip"},
        "dest_port": {"$ref": "#/$defs/port"},
        "proto": {"enum": ["TCP", "UDP"]},
        "alert": {"$ref": "#/$defs/alert"},
        "flow_id": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "pcap_cnt": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "tx_id": {"type": "integer", "minimum": 0, "maximum": 4294967295},
        "app_proto": {"$ref": "#/$defs/printable64"},
        "direction": {"enum": ["to_server", "to_client"]},
        "pkt_src": {"$ref": "#/$defs/printable64"},
        "community_id": {"$ref": "#/$defs/printable128"}
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_profile", "declared_version", "expected_digest",
        "sensor_id", "run_id", "ruleset_id"
      ],
      "properties": {
        "producer_profile": {"const": "suricata-8.0.7-alert-json-v1"},
        "declared_version": {"const": "8.0.7"},
        "expected_digest": {"$ref": "#/$defs/digest"},
        "sensor_id": {"$ref": "#/$defs/identifier"},
        "run_id": {"$ref": "#/$defs/identifier"},
        "ruleset_id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
