{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://megalodon.local/contracts/zeek-conn-log/v1/producer/schema.json",
  "title": "MEGALODON Zeek 8.0.10 declared conn.log profile; native producer NOT QUALIFIED",
  "$comment": "One owner-selected 8.0.10 private-build candidate, recorded by PR #519. The closed admission API validates declarations and metadata-file integrity; fixture validation does not attest an installed binary, loaded configuration, native output, capture completeness or owner acceptance. The earlier 0.0.0 placeholder remains in Git history.",
  "$defs": {
    "connAddr": {
      "type": "string",
      "minLength": 2,
      "maxLength": 45,
      "pattern": "^[0-9A-Fa-f:.]+$"
    },
    "connPort": {
      "type": "integer",
      "minimum": 0,
      "maximum": 65535
    },
    "connCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1099511627775
    },
    "printableField": {
      "type": "string",
      "minLength": 0,
      "maxLength": 256,
      "pattern": "^[ -~]*$"
    },
    "tunnelParents": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "maxLength": 64, "pattern": "^[A-Za-z0-9]+$"}
    },
    "connJsonRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ts", "id.orig_h", "id.orig_p", "id.resp_h", "id.resp_p",
        "proto", "conn_state", "orig_pkts", "resp_pkts",
        "orig_ip_bytes", "resp_ip_bytes"
      ],
      "properties": {
        "ts": {"type": "number", "minimum": 0},
        "uid": {"$ref": "#/$defs/printableField"},
        "id.orig_h": {"$ref": "#/$defs/connAddr"},
        "id.orig_p": {"$ref": "#/$defs/connPort"},
        "id.resp_h": {"$ref": "#/$defs/connAddr"},
        "id.resp_p": {"$ref": "#/$defs/connPort"},
        "proto": {"enum": ["tcp", "udp", "icmp"]},
        "service": {"$ref": "#/$defs/printableField"},
        "duration": {"type": "number", "minimum": 0},
        "orig_bytes": {"$ref": "#/$defs/connCount"},
        "resp_bytes": {"$ref": "#/$defs/connCount"},
        "conn_state": {"$ref": "#/$defs/printableField"},
        "local_orig": {"type": "boolean"},
        "local_resp": {"type": "boolean"},
        "missed_bytes": {"$ref": "#/$defs/connCount"},
        "history": {"$ref": "#/$defs/printableField"},
        "orig_pkts": {"$ref": "#/$defs/connCount"},
        "orig_ip_bytes": {"$ref": "#/$defs/connCount"},
        "resp_pkts": {"$ref": "#/$defs/connCount"},
        "resp_ip_bytes": {"$ref": "#/$defs/connCount"},
        "tunnel_parents": {"$ref": "#/$defs/tunnelParents"},
        "ip_proto": {"$ref": "#/$defs/connCount"}
      }
    },
    "profileConnJsonRecord": {
      "allOf": [
        {
          "$ref": "#/$defs/connJsonRecord"
        },
        {
          "required": [
            "uid",
            "missed_bytes"
          ],
          "properties": {
            "ts": {
              "exclusiveMaximum": 4102444800
            },
            "duration": {
              "exclusiveMaximum": 604800
            },
            "orig_pkts": {
              "maximum": 2147483647
            },
            "resp_pkts": {
              "maximum": 2147483647
            },
            "ip_proto": {
              "maximum": 255
            }
          }
        }
      ]
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "producer_profile",
        "declared_version",
        "format",
        "source_archive_digest",
        "binary_digest",
        "configuration_digest",
        "expected_digest",
        "expected_records",
        "source_id",
        "run_id"
      ],
      "properties": {
        "producer_profile": {
          "const": "zeek-8.0.10-conn-json-tsv-v1"
        },
        "declared_version": {
          "const": "8.0.10"
        },
        "source_archive_digest": {
          "const": "sha256:dbb1cb6c1eac27a8883ee4bd229a378b2f1253fa18e16cdeaaef8a00f124ddf1"
        },
        "binary_digest": {
          "const": "sha256:9a373fa2f32469432273af0c793455af59a34195a88beb9963c8d2e0e648f161"
        },
        "configuration_digest": {
          "const": "sha256:be7b117ee3a229884e6a6289fc3140ae32373df26a7b58b1616e87ce4092b0ed"
        },
        "format": {
          "enum": [
            "json",
            "tsv"
          ]
        },
        "expected_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$(?![\\s\\S])"
        },
        "expected_records": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        },
        "run_id": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$(?![\\s\\S])"
        }
      }
    }
  }
}
